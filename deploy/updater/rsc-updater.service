[Unit]
Description=RSC Frya Fresena Update-Helfer: Anfrage aus dem Hub ausführen
After=docker.service network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=RSC_APP=/opt/docker/apps/rsc-frya-fresena
ExecStart=/usr/bin/python3 /usr/local/sbin/rsc-updater.py
TimeoutStartSec=90min
