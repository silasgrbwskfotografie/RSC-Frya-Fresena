# Kopieren nach .env und ausfüllen (setup.sh macht das und fragt die Werte ab). Die .env kommt nie ins Repository.

# Adresse von Webseite (/) und Hub (/hub). Das ist der EINZIGE Wert, der beim Wechsel auf eine andere Domain geändert wird.
# Vorläufig: DOMAIN=pferd.silasgrbwskfotografie.de (DNS-A-Eintrag auf die Server-IP)
DOMAIN=pferd.example.de

# Nur mit eigenem Caddy (nicht hinter dem zentralen Proxy):
# E-Mail für das Let's-Encrypt-Zertifikat (Hinweise bei Ablauf o. Ä.)
ACME_EMAIL=
# Weitere Adressen, die dauerhaft auf DOMAIN umleiten (mehrere mit Leerzeichen, ohne Anführungszeichen), z. B.:
# REDIRECT_DOMAINS=www.pferd.example.de

# Erster Admin-Zugang (wird nur angelegt, solange es noch keinen Benutzer gibt). Passwort tippt setup.sh ab.
TMH_ADMIN_USER=admin
TMH_ADMIN_PASSWORD=

# Auf 1 setzen, um das Passwort von TMH_ADMIN_USER beim nächsten Start zurückzusetzen (danach wieder auf 0)
TMH_RESET_PASSWORD=0

# Wie viele tägliche Sicherungen aufbewahrt werden
TMH_BACKUP_KEEP=14

# Optional: Versionsprüfung im Hub (Admin > Updates) gegen die Rohadresse von server.py im Repository, leer = aus.
# Bei einem privaten Repository leer lassen (der Update-Helfer prüft dann über git auf dem Server).
# TMH_UPDATE_URL=https://raw.githubusercontent.com/<konto>/<repository>/main/server.py
# TMH_REPO_URL=https://github.com/<konto>/<repository>

# Optional: nur für die Befehle auf der Seite Admin (SSH-Benutzer und Name der Schlüsseldatei am PC, ohne Endung)
# TMH_SSH_USER=
# TMH_SSH_KEY=
# Ordner des Projekts auf dem Server (Standard /opt/docker/apps/rsc-frya-fresena)
# TMH_HOST_DIR=/opt/docker/apps/rsc-frya-fresena
